@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(GSL REQUIRED)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(CFITSIO REQUIRED)

if(@FFTW3F_FOUND@)
    find_dependency(FFTW3F REQUIRED)
endif()

if(@ENABLE_SYS_HDF5@)
    find_dependency(HDF5 REQUIRED COMPONENTS C)
endif()

if(@HDF5_IS_PARALLEL@)
    find_dependency(MPI REQUIRED COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HermesTargets.cmake")

set(Hermes_VERSION "@PROJECT_VERSION@")
set_and_check(Hermes_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

check_required_components(Hermes)
